[Unit]
Description=herdweb Tailscale debug bridge for herdr herdweb-dev
Documentation=file://%h/projects/oss/herdweb/docs/deploy-herdr.md

[Service]
Type=simple
Restart=on-failure
RestartSec=3
Environment=HOME=%h
Environment=PATH=%h/.local/share/fnm/aliases/default/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/projects/oss/herdweb
ExecStart=%h/.local/share/fnm/aliases/default/bin/pnpm exec tsx cli.ts serve --host 127.0.0.1 --port 7691 --base-path /herdweb --config %h/projects/oss/herdweb/.omo/herdweb-debug.config.ts
