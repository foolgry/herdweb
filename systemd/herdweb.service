[Unit]
Description=herdweb production bridge for the default herdr session
Documentation=file://%h/.local/share/herdweb/docs/deploy-herdr.md
# Restart=always means a signalled exit (status 0) still restarts, so bound the
# loop instead of letting a genuinely broken service spin forever.
StartLimitIntervalSec=60
StartLimitBurst=8

[Service]
Type=simple
# SIGTERM is recorded as success, so on-failure never brought the bridge back:
# an earlyoom/oomd kill left the phone UI down until a human restarted it.
Restart=always
RestartSec=3
Environment=HOME=%h
Environment=PATH=%h/.local/share/fnm/aliases/default/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/.local/share/herdweb
ExecStart=%h/.local/share/herdweb/scripts/serve-prod.sh serve --host 127.0.0.1 --port 7681 -- herdr --session default

[Install]
WantedBy=default.target
